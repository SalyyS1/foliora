{
  "name": "@foliora/extension",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/package-extension.mjs && node scripts/validate-artifact.mjs",
    "check": "tsc --noEmit",
