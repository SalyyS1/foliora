    "validate:artifact": "node scripts/validate-artifact.mjs",
    "native-host:install": "node scripts/install-native-host.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
